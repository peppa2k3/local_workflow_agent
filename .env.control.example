# VPS ONLY: copy to .env.control; never copy the local .env/Atlas credential.
CONTROL_PUBLIC_URL=https://control.example.com
CONTROL_BIND=127.0.0.1
CONTROL_PORT=34800
CONTROL_DATABASE=./data/control/control.sqlite
# Enable only with a trusted reverse proxy connecting from loopback and replacing X-Forwarded-For.
CONTROL_TRUST_PROXY=1
# Development only; permits HTTP for literal loopback origins, never public HTTP.
CONTROL_ALLOW_HTTP_LOOPBACK=0
