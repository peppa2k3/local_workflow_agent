# Paste your Atlas connection string here. Keep this file's real values in .env only.
# Example format: mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=team_content
