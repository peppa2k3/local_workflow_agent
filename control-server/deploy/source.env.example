# Copy this file to /opt/agent-local/.env on the VPS and edit CONTROL_DOMAIN.
# Keep the project and volume names stable across deployments.
COMPOSE_PROJECT_NAME=local-agent-control
CONTROL_DOMAIN=agent.dangngochai.io.vn
CONTROL_VOLUME_NAME=local-agent-control-data
# Uncomment for VPS deployments using Traefik's Docker provider.
# TRAEFIK_NETWORK=web
# TRAEFIK_CONTAINER=traefik
# TRAEFIK_HTTPS_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
