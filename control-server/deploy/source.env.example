# Copy to /opt/agent-local/.env on the VPS; replace every example value.
COMPOSE_PROJECT_NAME=local-agent-control
CONTROL_DOMAIN=agent.dangngochai.io.vn
# Existing Docker network that the Traefik container also uses.
TRAEFIK_NETWORK=traefik-public
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Leave empty if Traefik uses an already-loaded certificate.
TRAEFIK_CERT_RESOLVER=letsencrypt
CONTROL_ROUTER=local-agent-control
# Exact Traefik IP on TRAEFIK_NETWORK. No CIDR or '*'.
CONTROL_TRUSTED_PROXY_IPS=172.20.0.2
# Preserve this name to keep existing SQLite data across deployments.
CONTROL_VOLUME_NAME=local-agent-control-data
