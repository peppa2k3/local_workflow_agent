# VPS: copy this file to .env NEXT TO docker-compose.yml.
# Replace every example value with your deployment values.
COMPOSE_PROJECT_NAME=local-agent-control
CONTROL_IMAGE=your-dockerhub-user/local-agent-control:1.0.0
CONTROL_DOMAIN=control.example.com
# Name of the network already attached to your Traefik container.
TRAEFIK_NETWORK=traefik-public
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Set the existing ACME resolver name, or leave empty for an already-loaded TLS certificate.
TRAEFIK_CERT_RESOLVER=letsencrypt
CONTROL_ROUTER=local-agent-control
# EXACT Traefik IP on TRAEFIK_NETWORK, from docker inspect. No CIDR or '*'.
# Update if that IP changes; prefer a static Traefik IP in its own compose config.
CONTROL_TRUSTED_PROXY_IPS=172.20.0.2
# Preserve this name across releases to retain accounts/devices/commands.
CONTROL_VOLUME_NAME=local-agent-control-data
