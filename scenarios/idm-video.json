{
  "name": "Tải video bằng IDM",
  "variables": {
    "video_url": "https://example.com/video",
    "thu_muc_tai": "D:\\Videos"
  },
  "steps": [
    {
      "action": "idmDownload",
      "url": "{{video_url}}",
      "directory": "{{thu_muc_tai}}",
      "quality": 1080,
      "playVideo": true,
      "timeoutMs": 120000,
      "downloadTimeoutMs": 1800000
    }
  ]
}
