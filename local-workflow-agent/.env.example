# Paste your Atlas connection string here. Keep this file's real values in .env only.
# Example format: mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=team_content
# Optional: comma-separated DNS server IPs for this Node process when SRV lookup fails.
# MONGODB_DNS_SERVERS=

# Loopback server and default Chrome directory (not the display name).
LOCAL_AGENT_PORT=34719
CHROME_PROFILE=Profile 2
# Optional automation API token: 32-256 printable characters, no spaces.
# LOCAL_AGENT_API_TOKEN=
# Optional overrides; standalone defaults stay inside this app.
# LOCAL_AGENT_DATA_DIR=D:\WorkflowData
# LOCAL_AGENT_SCENARIOS_DIR=D:\WorkflowScenarios
# YTDLP_PATH=C:\VideoTools\yt-dlp.exe
# FFMPEG_PATH=C:\VideoTools\ffmpeg.exe
# FFPROBE_PATH=C:\VideoTools\ffprobe.exe
